{
  "name": "@mrclrchtr/supi-lsp",
  "version": "1.10.0",
  "description": "SuPi Language Server Protocol integration library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrclrchtr/supi.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi",
    "lsp"
  ],
  "files": [
    "src/**/*.ts",
    "src/**/*.json",
    "!__tests__"
  ],
  "dependencies": {
    "@mrclrchtr/supi-code-runtime": "workspace:*",
    "@mrclrchtr/supi-core": "workspace:*",
    "ignore": "^7.0.5",
    "typescript": "6.0.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5"
  },
  "bundledDependencies": [
    "@mrclrchtr/supi-code-runtime",
    "@mrclrchtr/supi-core",
    "ignore",
    "typescript",
    "vscode-jsonrpc",
    "vscode-languageserver-protocol",
    "vscode-languageserver-types"
  ],

  "devDependencies": {
    "@mrclrchtr/supi-test-utils": "workspace:*",
    "vitest": "4.1.7"
  },

  "main": "src/api.ts",
  "exports": {
    "./api": "./src/api.ts",
    "./package.json": "./package.json",
    "./provider/lsp-semantic-provider": "./src/provider/lsp-semantic-provider.ts"
  }
}
